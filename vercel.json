{
  "redirects": [
    {
      "source": "/app",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/app/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/website",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/website/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mobile",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/mobile/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
